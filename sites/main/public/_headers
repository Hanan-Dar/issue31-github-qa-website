# Headers for the static files (Cloudflare Workers static assets).
# The CSP allows no inline script except what the build itself emits: it replaces
# {INLINE_SCRIPT_HASHES} with the sha256 of each inline <script> (packages/theme/src/csp.ts).
# Turnstile (challenges.cloudflare.com) protects the contact form; videos (YouTube without cookies,
# Vimeo) and maps (Google Maps) are free-form sections' embeds; Cloudflare Web Analytics
# (static.cloudflareinsights.com) can be switched on in the dashboard.
/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'self'; script-src 'self' {INLINE_SCRIPT_HASHES} https://challenges.cloudflare.com https://static.cloudflareinsights.com; connect-src 'self' https://challenges.cloudflare.com https://cloudflareinsights.com; frame-src https://challenges.cloudflare.com https://www.youtube-nocookie.com https://player.vimeo.com https://www.google.com; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000

# Build output has content hashes in its names: cache for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Images and icons keep their names: cache for a week.
/media/*
  Cache-Control: public, max-age=604800
/favicons/*
  Cache-Control: public, max-age=604800
