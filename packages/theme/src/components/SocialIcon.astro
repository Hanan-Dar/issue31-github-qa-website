---
// A social network's mark, drawn at build time in the same line style as the theme's Lucide icons
// (Lucide has no brand icons). An unknown network shows a link icon. Decorative: the link it's in
// carries the network's name.
interface Props { name: string; class?: string }
const { name, class: cls = "h-5 w-5" } = Astro.props;
const PATHS: Record<string, string> = {
