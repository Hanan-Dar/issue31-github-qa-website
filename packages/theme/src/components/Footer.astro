---
// The site footer: the business, how to reach it, the link columns and the legal line. Its layout
// is the site's style (look.footer): "columns" (a dark band with the link columns) or "simple" (a
// light strip: the logo, the links in a row, how to reach the business, the legal line). Its widget
// area (src/content/widget-areas/footer.yaml, Craeft's Edit fills it) adds a row of columns above
// the legal line; without widgets the footer is as it always was.
import { getEntry } from "astro:content";
import site from "virtual:site/config";
import { navigation } from "virtual:site/data";
import AreaWidgets from "../blocks/area/AreaWidgets.astro";
import { linkOn } from "../lib/content";
import { addressLine, telHref } from "../lib/format";
import { editorMarkers, mark } from "../lib/preview";
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";

const year = new Date().getFullYear();
const columns = navigation.footer.map((c) => ({ ...c, links: c.links.filter((l) => linkOn(l.href)) })).filter((c) => c.links.length);
const SOCIAL: Record<string, string> = {
  "facebook.com": "Facebook",
  "instagram.com": "Instagram",
  "linkedin.com": "LinkedIn",
  "x.com": "X",
  "twitter.com": "X",
  "youtube.com": "YouTube",
  "tiktok.com": "TikTok",
};
const social = site.social.map((url) => ({ url, label: Object.entries(SOCIAL).find(([d]) => url.includes(d))?.[1] ?? new URL(url).hostname }));
const address = addressLine();
const simple = site.look?.footer === "simple";
// The simple footer's links: every column's, once each.
const links = [...new Map(columns.flatMap((c) => c.links).map((l) => [l.href, l])).values()];
// The widget area: drawn when it has widgets, and always in previews (empty, it takes no room), so
// Craeft's Edit has its place to fill.
const widgets = (await getEntry("widget-areas", "footer"))?.data.blocks ?? [];
const area = widgets.length > 0 || editorMarkers;
const { pathname } = Astro.url;
const areaGrid = "container grid gap-10 py-12 empty:hidden sm:grid-cols-2 lg:grid-cols-4";
---

{
  simple && (
    <footer class="border-t border-line bg-page">
      <div class="container flex flex-col gap-8 py-12 lg:flex-row lg:items-start lg:justify-between">
        <div class="max-w-sm">
          <Logo />
          <ul class="mt-5 grid gap-2 text-ink-2">
            <li class="flex items-center gap-2.5"><Icon name="Mail" class="h-4 w-4 shrink-0" /><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></li>
            {site.contact.phone && <li class="flex items-center gap-2.5"><Icon name="Phone" class="h-4 w-4 shrink-0" /><a href={telHref(site.contact.phone)}>{site.contact.phone}</a></li>}
            {address && <li class="flex items-start gap-2.5"><Icon name="MapPin" class="mt-1 h-4 w-4 shrink-0" />{address}</li>}
          </ul>
        </div>
        <nav aria-label="Footer">
          <ul class="flex flex-wrap gap-x-6 gap-y-2">
            {links.map((l) => (
              <li><a href={l.href} class="font-medium text-ink no-underline hover:underline">{l.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
      {
        area && (
          <div class="border-t border-line has-[>[data-craeft-area]:empty]:hidden">
            <div class={areaGrid} {...mark({ area: "footer" })}>
              <AreaWidgets area="footer" blocks={widgets} path={pathname} />
            </div>
          </div>
        )
      }
      <div class="container flex flex-col gap-4 border-t border-line py-6 text-sm text-ink-3 md:flex-row md:items-center md:justify-between">
        <p>© {year} {site.legalName ?? site.name}. All rights reserved.</p>
        {
          social.length > 0 && (
            <ul class="flex flex-wrap gap-4">
              {social.map((s) => (
                <li><a href={s.url} rel="noopener me" class="text-ink-2 no-underline hover:underline">{s.label}</a></li>
              ))}
            </ul>
          )
        }
      </div>
    </footer>
  )
}

{!simple && (
<footer class="tone-dark">
  <div class="container grid gap-12 py-16 lg:grid-cols-[1.2fr_2fr]">
    <div class="max-w-sm">
      <Logo dark />
      <p class="mt-5 text-white/80">{site.description}</p>
      <p class="mt-3 text-white/80">Gas Safe registered engineers covering Leeds and the nearby villages since 2014.</p>
      <ul class="mt-6 grid gap-2.5">
        <li class="flex items-center gap-2.5"><Icon name="Mail" class="h-4 w-4 shrink-0" /><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></li>
        {site.contact.phone && <li class="flex items-center gap-2.5"><Icon name="Phone" class="h-4 w-4 shrink-0" /><a href={telHref(site.contact.phone)}>{site.contact.phone}</a></li>}
        {address && <li class="flex items-start gap-2.5 text-white/80"><Icon name="MapPin" class="mt-1 h-4 w-4 shrink-0" />{address}</li>}
      </ul>
    </div>
    <div class="grid grid-cols-2 gap-10 sm:grid-cols-3">
      {
        columns.map((col) => (
          <div>
            <h2 class="font-sans text-sm font-semibold tracking-[0.12em] text-white/75 uppercase">{col.title}</h2>
            <ul class="mt-4 grid gap-2.5">
              {col.links.map((l) => (
                <li><a href={l.href} class="no-underline hover:underline">{l.label}</a></li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
  {
    area && (
      <div class="border-t border-white/15 has-[>[data-craeft-area]:empty]:hidden">
        <div class={areaGrid} {...mark({ area: "footer" })}>
          <AreaWidgets area="footer" blocks={widgets} path={pathname} />
        </div>
      </div>
    )
  }
  <div class="border-t border-white/15">
    <div class="container flex flex-col gap-4 py-6 text-sm text-white/75 md:flex-row md:items-center md:justify-between">
      <p>© {year} {site.legalName ?? site.name}. All rights reserved.</p>
      {
        social.length > 0 && (
          <ul class="flex flex-wrap gap-4">
            {social.map((s) => (
              <li><a href={s.url} rel="noopener me" class="no-underline hover:underline">{s.label}</a></li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</footer>
)}
