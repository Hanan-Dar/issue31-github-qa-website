---
// Served (with a 404 status) for any address that isn't a page.
import site from "virtual:site/config";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title={`Page not found | ${site.name}`} description="The page you were looking for isn't here. It may have moved, or the link may be mistyped." path="/404" noindex>
  <section class="bg-tint">
    <div class="container py-24 text-center lg:py-32">
      <p class="eyebrow">Error 404</p>
      <h1 class="h-page mt-4">Sorry, we can't find that page</h1>
      <p class="lead mx-auto mt-5 max-w-xl">It may have moved, or the link may be mistyped. These should help:</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/" class="btn btn-primary">Go to the home page</a>
        <a href="/contact" class="btn btn-secondary">Contact us</a>
      </div>
    </div>
  </section>
</BaseLayout>
