---
// What customers say. Only real reviews belong here, with the customer's permission. Typed in the
// section, or the site's testimonials (src/content/testimonials/) chosen by Craeft's widgets
// (packages/widgets, plan/ux/widgets.md); as cards (the default, as before widgets), a carousel or
// one large quote. No review structured data: Google ignores a business's own reviews for stars.
import { getCollection } from "astro:content";
import { type Review as ReviewData, selectReviews } from "@craeft/widgets/testimonials";
import type { z } from "astro/zod";
import Icon from "../components/Icon.astro";
import { editorMarkers } from "../lib/preview";
import { pageSeed } from "../lib/posts";
import { columnsClass, ENTRANCE, GAP } from "./posts/layout";
import ScriptEntrance from "./posts/ScriptEntrance.astro";
import type { TestimonialsBlock } from "./schema";
import Review from "./testimonials/Review.astro";
import UiCarousel from "./ui/Carousel.astro";
import Section from "./ui/Section.astro";
import SectionHeader from "./ui/SectionHeader.astro";

interface Props { data: z.infer<typeof TestimonialsBlock>; index: number; page?: { path?: string; commit?: string } }
const { data, index, page } = Astro.props;
const hid = `block-${index}`;
const collection = data.show === "collection" ? await getCollection("testimonials") : [];
const sel = selectReviews<ReviewData>(data, collection, { seed: pageSeed(page) });
const reviews = sel.items;
const stars = (r: ReviewData) => sel.stars === "all" || (sel.stars === "each" && !!r.rating);
const layout = data.layout;
const entrance = data.entrance !== "none" && layout === "grid";
const Enter = entrance ? "craeft-entrance" : Fragment;
const card = { plain: "flex flex-col", bordered: "card shadow-none flex flex-col p-6 sm:p-7", raised: "card flex flex-col p-6 sm:p-7" }[data.cardStyle];
const linked = data.summaryLink && data.summary;
---

{
  reviews.length > 0 && (
    <Section tone={data.tone} labelledby={hid}>
      <SectionHeader id={hid} eyebrow={data.eyebrow} title={data.title} lead={data.lead} center={layout === "quote"} />
      {data.summary && (
        <p class:list={["mt-4 flex items-center gap-2 font-semibold text-ink [.tone-dark_&]:text-white", layout === "quote" && "justify-center"]}>
          <Icon name="Star" class="h-5 w-5 fill-current text-accent-ink [.tone-dark_&]:text-white" />
          {linked ? <a href={data.summaryLink}>{data.summary}</a> : data.summary}
        </p>
      )}
      {layout === "quote" ? (
        <Review review={reviews[0]} stars={stars(reviews[0])} photos={data.photos} large />
      ) : layout === "carousel" ? (
        <UiCarousel data={data} dots={reviews.map((r, i) => `Show ${i + 1}: ${r.name}`)} label={data.title}>
          {reviews.map((r, i) => (
            <li class="carousel-item snap-start" aria-label={`${i + 1} of ${reviews.length}`}>
              <div class:list={[card, "h-full"]}>
                <Review review={r} stars={stars(r)} photos={data.photos} starRow={sel.stars !== "none"} />
              </div>
            </li>
          ))}
        </UiCarousel>
      ) : (
        <Enter {...(entrance ? { class: "block", "data-still": editorMarkers ? "" : undefined } : {})}>
          <ul class:list={["mt-10 grid", GAP[data.gap], columnsClass(data.columns), !data.equalHeights && "items-start"]}>
            {reviews.map((r) => (
              <li class:list={[card, ENTRANCE[data.entrance]]}>
                <Review review={r} stars={stars(r)} photos={data.photos} starRow={sel.stars !== "none"} />
              </li>
            ))}
          </ul>
        </Enter>
      )}
    </Section>
  )
}
{
  reviews.length === 0 && editorMarkers && (
    <Section tone={data.tone} labelledby={hid}>
      <SectionHeader id={hid} eyebrow={data.eyebrow} title={data.title} lead={data.lead} />
      <div data-craeft-empty class="mt-6 rounded-[var(--radius-card)] border-2 border-dashed border-ink/25 p-6 text-ink-2 [.tone-dark_&]:border-white/40 [.tone-dark_&]:text-white/85">
        <strong>No reviews show.</strong> {sel.reason ?? ""} Visitors don't see this box.
      </div>
    </Section>
  )
}
{entrance && <ScriptEntrance />}
