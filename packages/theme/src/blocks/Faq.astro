---
// Questions and answers: typed in the section, or the site's questions (src/content/faq/) chosen by
// Craeft's widgets (packages/widgets, plan/ux/widgets.md). As an accordion (each opening in place,
// no JavaScript: <details>; the default, exactly as before widgets), two columns or a list. The same
// questions go to search engines (lib/page-schema.ts).
import { getCollection } from "astro:content";
import { type Question, selectQuestions } from "@craeft/widgets/faq";
import type { z } from "astro/zod";
import Icon from "../components/Icon.astro";
import { mdInline } from "../lib/md";
import { editorMarkers } from "../lib/preview";
import { pageSeed } from "../lib/posts";
import type { FaqBlock } from "./schema";
import Empty from "./ui/Empty.astro";
import Section from "./ui/Section.astro";
import SectionHeader from "./ui/SectionHeader.astro";

interface Props { data: z.infer<typeof FaqBlock>; index: number; page?: { path?: string; commit?: string } }
const { data, index, page } = Astro.props;
const hid = `block-${index}`;
const collection = data.show === "collection" ? await getCollection("faq") : [];
const sel = selectQuestions<Question>(data, collection, { seed: pageSeed(page) });
const items = sel.items;
const first = data.open === "first";
---

{
  items.length > 0 && (
    <Section tone={data.tone} labelledby={hid}>
      {data.layout === "accordion" ? (
        <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr]">
          <SectionHeader id={hid} eyebrow={data.eyebrow} title={data.title} lead={data.lead} />
          <div class="grid gap-3">
            {items.map((f, i) => (
              <details class="card group p-0" open={first && i === 0 ? true : undefined}>
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 text-lg font-semibold [&::-webkit-details-marker]:hidden">
                  {f.question}
                  <Icon name="ChevronDown" class="h-5 w-5 shrink-0 transition-transform group-open:rotate-180" />
                </summary>
                <p class="px-6 pb-6 text-ink-2 [.tone-dark_&]:text-white/80" set:html={mdInline(f.answer)} />
              </details>
            ))}
          </div>
        </div>
      ) : (
        <Fragment>
          <SectionHeader id={hid} eyebrow={data.eyebrow} title={data.title} lead={data.lead} />
          <div class:list={["mt-10", data.layout === "columns" ? "grid gap-x-12 gap-y-9 md:grid-cols-2" : "max-w-3xl divide-y divide-line [.tone-dark_&]:divide-white/15"]}>
            {items.map((f) => (
              <div class:list={[data.layout === "list" && "py-6 first:pt-0 last:pb-0"]}>
                <h3 class="text-lg">{f.question}</h3>
                <p class="mt-2 text-ink-2 [.tone-dark_&]:text-white/80" set:html={mdInline(f.answer)} />
              </div>
            ))}
          </div>
        </Fragment>
      )}
    </Section>
  )
}
{items.length === 0 && editorMarkers && <Empty tone={data.tone} hid={hid} data={data} what="No questions show." reason={sel.reason} />}
