---
// A menu or price list: sections of items with a description, a price and short labels.
import type { z } from "astro/zod";
import { mdInline } from "../lib/md";
import type { MenuBlock } from "./schema";
import Section from "./ui/Section.astro";
import SectionHeader from "./ui/SectionHeader.astro";

interface Props { data: z.infer<typeof MenuBlock>; index: number }
const { data, index } = Astro.props;
const hid = `block-${index}`;
---

<Section tone={data.tone} labelledby={hid}>
  <SectionHeader id={hid} eyebrow={data.eyebrow} title={data.title} lead={data.lead} />
  <div class="mt-10 grid gap-6 lg:grid-cols-2">
    {
      data.sections.map((s, si) => (
        <section class="card p-6 sm:p-8" aria-labelledby={`${hid}-${si}`}>
          <h3 id={`${hid}-${si}`} class="text-2xl">{s.title}</h3>
          {s.note && <p class="mt-1 text-[0.95rem] text-ink-3 [.tone-dark_&]:text-white/75">{s.note}</p>}
          <ul class="mt-5 divide-y divide-line [.tone-dark_&]:divide-white/15">
            {s.items.map((it) => (
              <li class="flex items-start justify-between gap-6 py-4">
                <div>
                  <p class="font-semibold text-ink [.tone-dark_&]:text-white">
                    {it.name}
                    {it.tags.map((t) => (
                      <span class="ml-2 inline-block rounded-full border border-ink/20 px-2 py-0.5 align-middle text-xs font-semibold text-ink-2 [.tone-dark_&]:border-white/30 [.tone-dark_&]:text-white/85">{t}</span>
                    ))}
                  </p>
                  {it.description && <p class="mt-1 text-[0.97rem] text-ink-2 [.tone-dark_&]:text-white/80">{it.description}</p>}
                </div>
                {it.price && <p class="shrink-0 font-semibold text-ink [.tone-dark_&]:text-white">{it.price}</p>}
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
  {data.note && <p class="mt-8 max-w-3xl text-[0.95rem] text-ink-2 [.tone-dark_&]:text-white/80" set:html={mdInline(data.note)} />}
</Section>
