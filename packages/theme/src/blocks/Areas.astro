---
// The towns and areas the business covers (site.config.ts `areasServed`, unless listed here).
import type { z } from "astro/zod";
import site from "virtual:site/config";
import Icon from "../components/Icon.astro";
import { mdInline } from "../lib/md";
import type { AreasBlock } from "./schema";
import Section from "./ui/Section.astro";
import SectionHeader from "./ui/SectionHeader.astro";

interface Props { data: z.infer<typeof AreasBlock>; index: number }
const { data, index } = Astro.props;
const areas = data.areas ?? site.areasServed;
const hid = `block-${index}`;
---

<Section tone={data.tone} labelledby={hid}>
  <SectionHeader id={hid} eyebrow={data.eyebrow} title={data.title} lead={data.lead} />
  {
    areas.length > 0 && (
      <ul class="mt-8 flex flex-wrap gap-3">
        {areas.map((a) => (
          <li class="inline-flex items-center gap-2 rounded-full border border-line bg-white px-4 py-2 font-medium text-ink [.tone-dark_&]:border-white/20 [.tone-dark_&]:bg-white/5 [.tone-dark_&]:text-white">
            <Icon name="MapPin" class="h-4 w-4 text-primary-ink [.tone-dark_&]:text-white" />
            {a}
          </li>
        ))}
      </ul>
    )
  }
  {data.note && <p class="mt-8 max-w-3xl text-ink-2 [.tone-dark_&]:text-white/80" set:html={mdInline(data.note)} />}
</Section>
