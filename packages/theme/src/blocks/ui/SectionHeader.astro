---
import { mdInline } from "../../lib/md";
import Eyebrow from "./Eyebrow.astro";
interface Props { eyebrow?: string; title: string; lead?: string; id?: string; center?: boolean }
const { eyebrow, title, lead, id, center } = Astro.props;
---

<div class:list={["section-head max-w-3xl", center && "mx-auto text-center"]}>
  {eyebrow && <Eyebrow text={eyebrow} />}
  <h2 id={id} class:list={["h-section", eyebrow && "mt-3"]}>{title}</h2>
  {lead && <p class="lead mt-4" set:html={mdInline(lead)} />}
</div>
