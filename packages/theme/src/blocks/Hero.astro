---
// The top of a page. "home": large, for the home page. "page": compact, with the breadcrumb.
import type { z } from "astro/zod";
import Icon from "../components/Icon.astro";
import { mdInline } from "../lib/md";
import type { HeroBlock } from "./schema";
import Btn from "./ui/Btn.astro";
import Eyebrow from "./ui/Eyebrow.astro";
import site from "virtual:site/config";
import { telHref } from "../lib/format";

interface Props { data: z.infer<typeof HeroBlock>; crumbs?: { name: string; path: string }[] }
const { data, crumbs = [] } = Astro.props;
const home = data.variant === "home";
// The home page's top without a picture: a card with the ways to get in touch (shown by the looks
// that want one, see global.css), so the space beside the title works for the business.
const contactCard = home && !data.image;
const phone = site.contact?.phone;
const firstHours = site.openingHours[0];
---

<section class:list={["hero relative overflow-hidden bg-tint", home ? "hero-home" : "hero-page"]}>
  <div aria-hidden="true" class="hero-glow pointer-events-none absolute -top-32 -right-32 h-[30rem] w-[30rem] rounded-full bg-[radial-gradient(closest-side,color-mix(in_oklab,var(--brand-accent)_35%,transparent),transparent)]"></div>
  {/* The "wow" motion's 3D background (motion/wow.ts draws it; hidden at other levels and with reduced motion). */}
  {home && <canvas class="hero-3d" data-hero-3d aria-hidden="true"></canvas>}
  <div class:list={["hero-inner container relative grid items-center gap-12", (data.image || contactCard) && "hero-split", data.image && "lg:grid-cols-[1.1fr_0.9fr]", home ? "py-16 lg:py-24" : "py-12 lg:py-16"]}>
    <div class:list={["hero-copy", !data.image && "max-w-3xl"]}>
      {
        !home && crumbs.length > 0 && (
          <nav aria-label="Breadcrumb" class="mb-6">
            <ol class="flex flex-wrap items-center gap-1.5 text-[0.92rem] text-ink-2">
              <li><a href="/" class="text-ink-2">Home</a></li>
              {crumbs.map((c, i) => (
                <li class="flex items-center gap-1.5">
                  <Icon name="ChevronRight" class="h-3.5 w-3.5" />
                  {i === crumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.path} class="text-ink-2">{c.name}</a>}
                </li>
              ))}
            </ol>
          </nav>
        )
      }
      {data.eyebrow && <Eyebrow text={data.eyebrow} />}
      <h1 class:list={[home ? "h-display" : "h-page", data.eyebrow && "mt-4"]}>{data.title}</h1>
      <p class="lead mt-5 max-w-2xl" set:html={mdInline(data.lead)} />
      {
        data.buttons.length > 0 && (
          <div class="mt-8 flex flex-wrap gap-3">
            {data.buttons.map((b, i) => <Btn button={b} fallback={i === 0 ? "primary" : "secondary"} />)}
          </div>
        )
      }
      {
        data.points.length > 0 && (
          <ul class="mt-8 grid gap-x-6 gap-y-2.5 text-[0.98rem] text-ink-2 sm:grid-cols-2">
            {data.points.map((p) => (
              <li class="flex items-start gap-2.5">
                <Icon name="CircleCheck" class="mt-0.5 h-5 w-5 shrink-0 text-primary-ink" />
                {p}
              </li>
            ))}
          </ul>
        )
      }
    </div>
    {
      contactCard && (
        <aside class="hero-card card hidden p-7" aria-label="Get in touch">
          <p class="eyebrow">Get in touch</p>
          {phone && (
            <a href={telHref(phone)} class="mt-3 flex items-center gap-3 text-2xl font-semibold text-ink no-underline">
              <span class="icon-tile"><Icon name="Phone" class="h-5 w-5" /></span>
              {phone}
            </a>
          )}
          {site.contact?.email && (
            <a href={`mailto:${site.contact.email}`} class="mt-4 flex items-center gap-3 text-ink-2 no-underline">
              <span class="icon-tile"><Icon name="Mail" class="h-5 w-5" /></span>
              {site.contact.email}
            </a>
          )}
          {firstHours && (
            <p class="mt-4 flex items-center gap-3 text-ink-2">
              <span class="icon-tile"><Icon name="Clock" class="h-5 w-5" /></span>
              {firstHours.day}s from {firstHours.opens} to {firstHours.closes}
            </p>
          )}
          {data.buttons[0] && <div class="mt-6"><Btn button={data.buttons[0]} fallback="primary" /></div>}
        </aside>
      )
    }
    {data.image && <img src={data.image.src} alt={data.image.alt} class="hero-media aspect-[4/3] w-full rounded-[var(--radius-card)] object-cover shadow-[var(--shadow-card)]" loading="eager" fetchpriority="high" sizes="(min-width: 1024px) 50vw, 100vw" />}
  </div>
</section>
