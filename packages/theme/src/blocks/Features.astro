---
// Cards with an icon, a title and a sentence or two; each can link to a page.
import type { z } from "astro/zod";
import Icon from "../components/Icon.astro";
import { linkOn } from "../lib/content";
import { mdInline } from "../lib/md";
import type { FeaturesBlock } from "./schema";
import Section from "./ui/Section.astro";
import SectionHeader from "./ui/SectionHeader.astro";

interface Props { data: z.infer<typeof FeaturesBlock>; index: number }
const { data, index } = Astro.props;
const COLS = { 2: "md:grid-cols-2", 3: "md:grid-cols-2 lg:grid-cols-3", 4: "md:grid-cols-2 lg:grid-cols-4" } as const;
const hid = `block-${index}`;
---

<Section tone={data.tone} labelledby={hid}>
  <SectionHeader id={hid} eyebrow={data.eyebrow} title={data.title} lead={data.lead} />
  <ul class:list={["mt-10 grid gap-5", COLS[data.columns]]}>
    {
      data.items.map((it) => (
        <li class="card flex flex-col p-6 sm:p-7">
          <span class="icon-tile"><Icon name={it.icon} /></span>
          <h3 class="mt-5 text-xl">{it.title}</h3>
          <p class="mt-2 flex-1 text-ink-2 [.tone-dark_&]:text-white/80" set:html={mdInline(it.text)} />
          {it.href && linkOn(it.href) && (
            <a href={it.href} class="mt-5 inline-flex items-center gap-1.5 font-semibold">
              {it.linkLabel ?? "Find out more"}<span class="sr-only">: {it.title}</span>
              <Icon name="ArrowRight" class="h-4 w-4" />
            </a>
          )}
        </li>
      ))
    }
  </ul>
</Section>
